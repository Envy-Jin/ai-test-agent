@@ -0,0 +1,26 @@
+"""公共鉴权模块：本次重构把分散在 handler 里的鉴权逻辑统一收口到这里。"""
+
+VALID_USERS: dict[str, str] = {
+    "13800138000": "Test123456",
+}
+
+
+def verify_credentials(phone: str, password: str) -> bool:
+    """校验手机号+密码（原内联在 do_POST 里，本次迁移）。"""
+    return VALID_USERS.get(phone) == password
+
+
+def issue_token(phone: str) -> str:
+    """签发 token：本次变更从固定 token 改为按用户派生（加盐）。"""
+    return f"demo-token-{phone[-4:]}"
+
+
+def require_auth(auth_header: str) -> str | None:
+    """校验 Authorization 头，返回 phone；失败返回 None。
+    调用方拿到 None 必须返回 401（本次变更的关键约束）。"""
+    if not auth_header.startswith("Bearer "):
+        return None
+    token = auth_header[len("Bearer "):]
+    return token if token.startswith("demo-token-") else None
