{
    "table_name": "refund",
    "description": "退款申请表，用于退款场景的测试数据生成",
    "fields": [
      {"name": "id", "field_type": "int", "required": true, "description": "退款单ID，自增主键", "primary_key": true},
      {"name": "refund_no", "field_type": "str", "required": true, "description": "退款单号", "max_length": 32},
      {"name": "order_no", "field_type": "str", "required": true, "description": "订单号", "max_length": 32},
      {"name": "amount", "field_type": "float", "required": true, "description": "退款金额（元）", "min_value": 0.01, "max_value": 999999.99},
      {"name": "reason", "field_type": "enum", "required": false, "description": "退款原因", "enum_values": ["质量问题", "七天无理由", "发错货", "其他"]},
      {"name": "status", "field_type": "enum", "required": true, "description": "退款单状态", "enum_values": ["待审核", "已退款", "已驳回"]}
    ]
  }